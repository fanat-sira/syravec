# только сервер, ключ не попадает в браузер
OPENROUTER_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=openai/gpt-6-luna
# json_schema для совместимых моделей, json_object или text для остальных
AI_RESPONSE_FORMAT=json_schema
# проверка назначения запроса, тот же OpenRouter API key
# auto-маршрутизация через Decisions работает и при выключенной защитной проверке
AI_GUARD_ENABLED=true
AI_GUARD_MODEL=openai/gpt-6-luna-decisions
# полный URL, отдельно от AI_BASE_URL: Decisions не находится под /api/v1
AI_GUARD_URL=https://openrouter.ai/api/alpha/decisions
WEB_PORT=3000

# loopback для локальной работы; внешний доступ — через reverse proxy с авторизацией
WEB_BIND=127.0.0.1
